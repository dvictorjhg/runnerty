{
  "$schema": "file:/Users/codertydev/workspace/runnerty/schemas/schemas/4.0/config.json",
  "general": {
    "planFilePath": "plan.json",
    "queues": {
      "refreshInterval": 100
    }
  },
  "triggers": [
    {
      "id": "schedule_default",
      "type": "@runnerty-trigger-schedule"
    },
    {
      "id": "immediate",
      "type": "@runnerty-trigger-immediate"
    }
  ],
  "executors": [
    {
      "id": "iterable_default",
      "type": "@runnerty-executor-iterable"
    },
    {
      "id": "shell_default",
      "type": "@runnerty-executor-shell"
    },
    {
      "id": "wait_default",
      "type": "@runnerty-executor-wait",
      "time": "60s"
    }
  ],
  "notifiers": [
    {
      "id": "console_default",
      "type": "@runnerty-notifier-console"
    }
  ],
  "global_values": [
    {
      "myparams": {
        "sample": "sample_value",
        "env_test": "CONFIG_@ENV(env_test)"
      }
    }
  ]
}
